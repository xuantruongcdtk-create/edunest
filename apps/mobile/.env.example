# Copy to .env and fill in. EXPO_PUBLIC_* values are PUBLIC (inlined into the bundle).
# Never put service-role keys or any server secret here.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
EXPO_PUBLIC_API_URL=https://<your-web-deployment>.vercel.app
