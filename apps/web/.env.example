# =============================================================================
# EduNest — .env.example  (commit file này, KHÔNG điền giá trị thực)
# Sao chép thành .env.local cho local dev
# Production: điền từng biến vào Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# --- SUPABASE ---
# https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GOOGLE AI (GEMINI) ---
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# --- UPSTASH REDIS ---
# https://console.upstash.com → chọn database → REST API tab
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- MOMO PAYMENT ---
# Sandbox: MOMO / F8BBA842ECF85 / K951B6PE1waDMi640xX08PD3vg6u
# Production: liên hệ business@momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Sandbox:    https://test-payment.momo.vn/v2/gateway/api/create
# Production: https://payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT=

# --- VNPAY ---
# Sandbox portal: https://sandbox.vnpayment.vn/apis/vnpay-api/
# Production: https://vnpayment.vn (liên hệ VNPAY để mở tài khoản merchant)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox:    https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=

# --- GOOGLE CLOUD VISION (OCR) ---
# Bước 1: console.cloud.google.com → IAM → Service Accounts → tạo account mới
# Bước 2: Grant role "Cloud Vision API User"
# Bước 3: Keys → Add Key → JSON → download file sa-key.json
# Bước 4: Chạy lệnh để convert thành 1 dòng:
#   node -e "console.log(JSON.stringify(require('./sa-key.json')))"
# Bước 5: Paste kết quả vào đây (1 dòng, không có dấu xuống hàng)
GOOGLE_CLOUD_CREDENTIALS=

# --- APP ---
# Local: http://localhost:3000
# Production: https://edunest.vn
NEXT_PUBLIC_APP_URL=https://edunest.vn

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- RESEND EMAIL ---
# https://resend.com/api-keys → Create API Key → tên "EduNest Production"
# Free tier: 3.000 email/tháng (đủ cho MVP)
RESEND_API_KEY=re_...
